# Copie este arquivo para .env e ajuste os valores.

# Em produção, gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL o projeto usa SQLite (db.sqlite3).
# Para usar PostgreSQL local (por exemplo, com docker compose up -d db):
# DATABASE_URL=postgres://equipes:equipes@localhost:5432/equipes
